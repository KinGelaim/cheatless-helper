<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.6" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Tesseract.Drawing" Version="5.2.0" />
  </ItemGroup>

  <Target Name="CheckAndCopyFile" AfterTargets="Build">
    <!-- Проверка существования файла -->
    <Message Text="Проверка файла tessdata\rus.traineddata" Importance="High" />
    <Error Text="Файл tessdata\rus.traineddata не найден!" Condition="!Exists('tessdata\rus.traineddata')" />

    <!-- Копирование файла, если он есть -->
    <Copy SourceFiles="tessdata\rus.traineddata" DestinationFolder="$(OutputPath)tessdata" Condition="Exists('tessdata\rus.traineddata')" />
  </Target>

</Project>